# Public Convex deployment URL. Set this in Vercel for Production, Preview,
# and Development environments. Example: https://your-project.convex.cloud
VITE_CONVEX_URL=

# Used by the Convex backend, not by Vercel. In your Convex deployment
# environment, set this to your Vercel production URL (for example,
# https://your-app.vercel.app) so email authentication callbacks work.
CONVEX_SITE_URL=http://localhost:5173

# Used locally by `npx convex dev`; do not add this as a Vercel environment variable.
CONVEX_DEPLOYMENT=
